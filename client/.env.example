PORT=3000
# Taller 7: todos los auth-services (el navegador hace failover entre ellos; si solo hay uno, basta esa URL)
AUTH_URLS=http://localhost:4001,http://localhost:4002,http://localhost:4003
# Taller 6: OPCIONAL. El juego pide un coordinador al auth (GET /coordinator) y se conecta al que le asignen;
# esta variable ya no se usa para conectar y puede quedar vacía.
COORDINATOR_WS_URL=
GOOGLE_CLIENT_ID=
# Segundos de gracia (en ms) sin coordinadores antes de que el juego y el espectador vuelvan al inicio avisando
# que se cayeron los servicios. Entero >= 5000; por defecto 45000 (45 s).
RECONNECT_GRACE_MS=45000
