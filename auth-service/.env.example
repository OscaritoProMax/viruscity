# Auth-service de un solo nodo (Talleres 5 y 6): npm start
# Para el clúster del Taller 7 usa .env.auth-a/b/c (copias de los .example) con npm run start:a / start:b / start:c.
PORT=4000
JWT_SECRET=cambia_este_valor_por_un_secreto_hex_de_64_caracteres
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
DB_PATH=./users.db
GOOGLE_CLIENT_ID=PEGA_AQUI_TU_CLIENT_ID.apps.googleusercontent.com
CLUSTER_SECRET=cambia_este_valor_por_un_secreto_hex_de_64_caracteres
COORDINATOR_TTL_MS=6000
RESERVATION_TTL_MS=3000

# Taller 7: identidad del nodo. Sin AUTH_NODES es un clúster de uno (líder desde el arranque).
# AUTH_ID=auth-solo
# PUBLIC_URL=http://localhost:4000

# Taller 7: parámetros del clúster de auth (valores por defecto; en un nodo único casi no se usan)
AUTH_HEARTBEAT_MS=2000
LEADER_TIMEOUT_MS=6000
ELECTION_JITTER_MS=1500
READ_TOLERANCE=10
WRITE_TIMEOUT_MS=3000
ACK_GRACE_MS=150
SYNC_BATCH=500
AUTH_PEER_PING_MS=3000
