# bcrypt y better-sqlite3 traen binarios precompilados (carpeta prebuilds/) para Windows, Linux y macOS.
# Sin esta opción, npm 11 intenta compilar better-sqlite3 con node-gyp al instalar desde package-lock.json
# y falla en equipos sin Visual Studio. "npm start" y "npm run dev" siguen funcionando con esta opción.
ignore-scripts=true
