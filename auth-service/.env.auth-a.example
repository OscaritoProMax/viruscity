# Nodo auth-a del clúster de auth (Taller 7): npm run start:a
# Copia este archivo como .env.auth-a (no se versiona) y pon los MISMOS JWT_SECRET, CLUSTER_SECRET y
# GOOGLE_CLIENT_ID en los tres nodos y en los coordinadores.
AUTH_ID=auth-a
PORT=4001
PEER_PORT=4101
PUBLIC_URL=http://localhost:4001
PEER_URL=ws://localhost:4101
# Todos los nodos (incluido este): id|publicUrl|peerUrl separados por comas. Igual en los tres archivos.
AUTH_NODES=auth-a|http://localhost:4001|ws://localhost:4101,auth-b|http://localhost:4002|ws://localhost:4102,auth-c|http://localhost:4003|ws://localhost:4103
DB_PATH=./users-a.db

JWT_SECRET=cambia_este_valor_por_un_secreto_hex_de_64_caracteres
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
GOOGLE_CLIENT_ID=PEGA_AQUI_TU_CLIENT_ID.apps.googleusercontent.com
CLUSTER_SECRET=cambia_este_valor_por_un_secreto_hex_de_64_caracteres
COORDINATOR_TTL_MS=6000
RESERVATION_TTL_MS=3000

# Parámetros del clúster de auth (valores por defecto)
AUTH_HEARTBEAT_MS=2000
LEADER_TIMEOUT_MS=6000
ELECTION_JITTER_MS=1500
READ_TOLERANCE=10
WRITE_TIMEOUT_MS=3000
ACK_GRACE_MS=150
SYNC_BATCH=500
AUTH_PEER_PING_MS=3000
