# Coordinador coord-a (Taller 6). Copia este archivo sin ".example" y pon los secretos reales.
# Identidad y red
COORDINATOR_ID=coord-a
PORT=5001
PEER_PORT=5101
PUBLIC_URL=ws://localhost:5001
PEER_URL=ws://localhost:5101
# Taller 7: todos los auth-services del clúster (el heartbeat va a todos; el directorio responde en cualquiera)
AUTH_URLS=http://localhost:4001,http://localhost:4002,http://localhost:4003
# Secretos: IDÉNTICOS a los de auth-service/.env
JWT_SECRET=el_mismo_secreto_del_auth_service
CLUSTER_SECRET=el_mismo_cluster_secret_del_auth_service
# Tiempos (ms): ping a los clientes, heartbeat al auth, descubrimiento, ping y sincronización del mesh
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_AUTH_MS=2000
PEER_DISCOVERY_MS=3000
PEER_PING_MS=3000
PEER_SYNC_MS=1000
# Juego (Taller 5)
WORLD_WIDTH=3840
WORLD_HEIGHT=3840
MAP_FILE=./map/virus-city.json
PLAYER_RADIUS=16
PLAYER_SPEED=200
TICK_RATE=20
MAX_EXTRAS_BYTES=1024
MAX_MSGS_PER_SEC=60
# Partida de Viruscity (balance/pruebas): valores por defecto; tiempos en ms, rangos en px
MIN_PLAYERS_TO_START=3
MATCH_COUNTDOWN_MS=10000
INITIAL_LOCK_MS=60000
INFECT_COOLDOWN_MS=120000
NEW_INFECTED_LOCK_MS=180000
MATCH_DURATION_MS=900000
RESULTS_MS=15000
RECONNECT_GRACE_MS=60000
MISSION_MIN_MS=8000
MISSION_MAX_MS=45000
INFECT_RANGE=70
MISSION_RANGE=60
RANGE_TOLERANCE=25
MATCH_REPLICATE_MS=250
GAME_TICK_MS=200
GAME_VIEW_MS=250
GAME_SYNC_WAIT_MS=1500
# Track 2.1 (persistencia): base node:sqlite PROPIA de este coordinador (no se versiona: *.db).
# Vacío = state-<COORDINATOR_ID>.db en coordinator/; "off" la desactiva. PERSIST_MS: cada cuánto se guarda;
# PERSIST_MAX_AGE_MS: lo guardado hace más que esto (10 min) no se recupera.
STATE_DB_PATH=./state-coord-a.db
PERSIST_MS=2000
PERSIST_MAX_AGE_MS=600000
