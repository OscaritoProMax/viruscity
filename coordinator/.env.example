# Coordinador coord-a (Taller 6). Instancia única (= coord-a). Copia este archivo como .env y pon los secretos reales.
# Identidad y red
COORDINATOR_ID=coord-a
PORT=5001
PEER_PORT=5101
PUBLIC_URL=ws://localhost:5001
PEER_URL=ws://localhost:5101
AUTH_URL=http://localhost:4000
# Secretos: IDÉNTICOS a los de auth-service/.env
JWT_SECRET=el_mismo_secreto_del_auth_service
CLUSTER_SECRET=el_mismo_cluster_secret_del_auth_service
# Tiempos (ms): ping a los clientes, heartbeat al auth, descubrimiento, ping y sincronización del mesh
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_AUTH_MS=2000
PEER_DISCOVERY_MS=3000
PEER_PING_MS=3000
PEER_SYNC_MS=1000
# Juego (Taller 5)
WORLD_WIDTH=3840
WORLD_HEIGHT=3840
MAP_FILE=./map/virus-city.json
PLAYER_RADIUS=16
PLAYER_SPEED=200
TICK_RATE=20
MAX_EXTRAS_BYTES=1024
MAX_MSGS_PER_SEC=60
