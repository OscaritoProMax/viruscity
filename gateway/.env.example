# Gateway para ngrok (Taller 7): un solo túnel (ngrok http 8080) delante de todo el sistema.
# Copia este archivo como .env (no se versiona). Sin .env se usan estos mismos valores por defecto.
PORT=8080
# /prefijo=destino separados por comas; al reenviar se quita el prefijo (también en los WebSocket)
GATEWAY_ROUTES=/auth-a=http://localhost:4001,/auth-b=http://localhost:4002,/auth-c=http://localhost:4003,/coord-a=http://localhost:5001,/coord-b=http://localhost:5002,/coord-c=http://localhost:5003
# Todo lo que no coincide con un prefijo va al client
GATEWAY_DEFAULT=http://localhost:3000
