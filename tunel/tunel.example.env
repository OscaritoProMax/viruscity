# Despliegue por túnel con 7 cuentas de ngrok: un túnel por servicio, SIN gateway ni proxy delante.
# Copia este archivo como tunel/tunel.env (no se versiona) y llena los 7 dominios fijos y los 7 authtoken.
# Cada cuenta gratuita de ngrok tiene UN dominio fijo: cópialo de dashboard.ngrok.com → Domains,
# y su authtoken de dashboard.ngrok.com → Your Authtoken.
# Luego: node tunel/configurar.js   (escribe los .env y las configuraciones de ngrok, e imprime los 7 comandos)

# Dominios (https://, sin ruta ni barra final)
CLIENT_URL=https://cliente-ejemplo.ngrok-free.app
AUTH_A_URL=https://auth-a-ejemplo.ngrok-free.app
AUTH_B_URL=https://auth-b-ejemplo.ngrok-free.app
AUTH_C_URL=https://auth-c-ejemplo.ngrok-free.app
COORD_A_URL=https://coord-a-ejemplo.ngrok-free.app
COORD_B_URL=https://coord-b-ejemplo.ngrok-free.app
COORD_C_URL=https://coord-c-ejemplo.ngrok-free.app

# Authtoken de la cuenta de ngrok dueña de cada dominio (son secretos: el script nunca los imprime)
CLIENT_TOKEN=
AUTH_A_TOKEN=
AUTH_B_TOKEN=
AUTH_C_TOKEN=
COORD_A_TOKEN=
COORD_B_TOKEN=
COORD_C_TOKEN=
